# ==============================================================================
# 감성 분석 서비스 (감성 분석 서비스) 환경 변수 템플릿 (.env.example)
# ==============================================================================
# 주의: 이 파일은 설정 형식 참고용 예시 파일입니다.
# 실제 비밀 키는 절대 이 파일이나 Git에 올리지 마시고, 로컬의 .env 파일에만 작성해 주세요.

# 1. OpenAI API 설정
# OpenAI 플랫폼(https://platform.openai.com/api-keys)에서 발급받은 비밀 API 키 (예: sk-proj-...)
OPENAI_API_KEY=your_openai_api_key_here

# 사용할 OpenAI 모델 ID (예: gpt-4o-mini 또는 gpt-4o)
# 코드에 모델명을 하드코딩하지 않고 환경 변수로 관리하여 유연하게 변경할 수 있습니다.
OPENAI_MODEL=gpt-4o-mini

# 2. Supabase 데이터베이스 설정
# Supabase 프로젝트 대시보드(Settings > API)의 Project URL (예: https://xyzcompany.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# Supabase 서버 전용 비공개 키 (service_role 키)
# 주의: anon public 키가 아닌 service_role 키를 사용하며, 프론트엔드에 절대 노출되면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

